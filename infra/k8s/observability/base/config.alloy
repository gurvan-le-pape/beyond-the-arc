// Every pod's logs, read through the Kubernetes API, pushed to Loki. It replaces
// production's Promtail, which tails containers through the Docker socket.
//
// Labelled as production's logs are, so the same queries work: `service` is the pod's
// app.kubernetes.io/name, which is the Compose service name for the application
// (backend, frontend, scheduler, migrate). `container` here is the container's name in
// its pod, where Promtail's is Docker's /docker-backend-1 form.

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
