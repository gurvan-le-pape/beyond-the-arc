# Managed by Ansible (infra/ansible/roles/postgres_backup). Read by bta-db-backup.service.
BACKUP_CONTAINER={{ postgres_backup_container }}
BACKUP_AGE_RECIPIENT={{ postgres_backup_age_recipient }}
BACKUP_BUCKET={{ postgres_backup_bucket }}
BACKUP_WEEKLY_ISODAY={{ postgres_backup_weekly_isoday }}
BACKUP_TEXTFILE_DIR={{ postgres_backup_textfile_dir }}
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT={{ postgres_backup_r2_endpoint }}
RCLONE_CONFIG_R2_ACCESS_KEY_ID={{ postgres_backup_r2_access_key_id }}
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY={{ postgres_backup_r2_secret_access_key }}
# The token is scoped to one bucket and cannot list or create buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
