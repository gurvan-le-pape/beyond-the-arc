{
  "extends": "./tsconfig.json",
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@modules/*": ["./modules/*"],
      "@common/*": ["./common/*"],
      "prisma/prisma.module": ["./prisma/prisma.module"],
      "prisma/prisma.service": ["./prisma/prisma.service"]
    },
    "outDir": "dist",
    // Emitted so a stack trace resolves back to TypeScript instead of to
    // compiled dist. The .map files ship next to dist/*.js in the runtime image
    // rather than being uploaded, so this needs no build-time Sentry token —
    // but it does need `node --enable-source-maps`, which the prod stage of
    // docker/backend/Dockerfile passes. Without that flag these files are inert.
    "sourceMap": true
  }
}
