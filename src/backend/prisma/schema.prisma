datasource db {
  provider = "postgresql"
}

// Both options below default to "inferred from environment", and what they
// infer from is the tsconfig. Moving the backend to `module: nodenext` flipped
// them without touching this file: the client came out ESM-flavoured, and the
// CommonJS emit then failed on it at load time. Nothing here is ESM —
// package.json declares no `"type": "module"` — so the format is pinned rather
// than inferred.
//
// The extension is pinned to bare because two resolvers have to agree on it.
// `nodenext` in CJS mode accepts an extension or none, but Jest's resolver
// does not rewrite `.js` to `.ts`, so the inferred `"js"` resolves under `tsc`
// and fails 24 suites with "Cannot find module ./internal/class.js".
//
// Note this whole schema is inlined verbatim into the generated client,
// comments included.
generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

model Regions {
  id          Int           @id @default(autoincrement())
  code        String        @unique @db.VarChar(10)
  name        String        @db.VarChar(255)
  departments Departments[]
  leagues     Leagues[]

  @@map("regions")
}

model Departments {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(10)
  name       String       @db.VarChar(255)
  regionId   Int          @map("region_id")
  // Restrict: regions are reference data — deleting one must not silently
  // cascade through departments → committees → clubs → teams.
  region     Regions      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  committees Committees[]

  @@map("departments")
}

model Leagues {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255)
  address       String?         @db.VarChar(255)
  regionId      Int             @map("region_id")
  region        Regions         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  committees    Committees[]
  championships Championships[]

  @@map("leagues")
}

model Committees {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255)
  address       String?         @db.VarChar(255)
  departmentId  Int             @map("department_id")
  department    Departments     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  league        Leagues         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId      Int             @map("league_id")
  clubs         Clubs[]
  championships Championships[]

  @@map("committees")
}

model Clubs {
  id          Int        @id @default(autoincrement())
  code        String?    @db.VarChar(50)
  name        String     @db.VarChar(255)
  address     String?    @db.VarChar(255)
  committeeId Int        @map("committee_id")
  // Restrict: a club cannot exist unaffiliated (committeeId is required), so
  // deleting a committee with clubs must be an explicit, ordered operation.
  committee   Committees @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  zipCode     String?    @map("zip_code") @db.VarChar(5)
  city        String?    @db.VarChar(255)
  latitude    Decimal?   @db.Decimal(10, 8)
  longitude   Decimal?   @db.Decimal(11, 8)
  teams       Teams[]

  @@index([committeeId], map: "idx_clubs_committee_id")
  @@map("clubs")
}

model Championships {
  id          Int         @id @default(autoincrement())
  category    String      @db.VarChar(100)
  seasonYear  String      @map("season_year") @db.VarChar(9)
  level       String      @db.VarChar(50)
  division    Int
  gender      String      @db.VarChar(10)
  // Restrict, not SetNull: `check_level` requires these ids at their level, so
  // nulling one would violate it — the delete fails either way, and Restrict
  // says why.
  committee   Committees? @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  committeeId Int?        @map("committee_id")
  league      Leagues?    @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  leagueId    Int?        @map("league_id")
  pools       Pools[]

  // committeeId is NULL at regional/national level, and NULLs never collide
  // in a unique constraint — so this alone cannot prevent duplicate
  // regional/national championships. The baseline migration adds a partial
  // unique index (WHERE committee_id IS NULL) covering that case; PSL cannot
  // express partial indexes, so it lives only in the migration SQL.
  @@unique([seasonYear, category, gender, level, division, committeeId, leagueId])
  @@map("championships")
}

model Pools {
  id             Int            @id @default(autoincrement())
  championship   Championships  @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  championshipId Int            @map("championship_id")
  letter         String         @db.VarChar(1)
  matches        Matches[]
  leaderboards   Leaderboards[]
  teams          Teams[]        @relation("PoolsToTeams")

  @@unique([championshipId, letter])
  @@map("pools")
}

model Teams {
  id           Int            @id @default(autoincrement())
  club         Clubs          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId       Int            @map("club_id")
  seasonYear   String         @map("season_year") @db.VarChar(9)
  number       Int
  category     String         @db.VarChar(100)
  gender       String         @db.VarChar(10)
  pool         Pools?         @relation("PoolsToTeams", fields: [poolId], references: [id], onDelete: SetNull)
  poolId       Int?           @map("pool_id")
  homeMatches  Matches[]      @relation("HomeTeam")
  awayMatches  Matches[]      @relation("AwayTeam")
  leaderboards Leaderboards[]
  players      Players[]

  @@unique([clubId, category, gender, number, seasonYear])
  @@index([poolId], map: "idx_teams_pool_id")
  @@map("teams")
}

model Matches {
  id               Int                @id @default(autoincrement())
  pool             Pools              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId           Int                @map("pool_id")
  matchday         Int
  startsAt         DateTime           @map("starts_at") @db.Timestamptz
  homeTeam         Teams              @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  homeTeamId       Int                @map("home_team_id")
  awayTeam         Teams              @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  awayTeamId       Int                @map("away_team_id")
  homeTeamScore    Int?               @map("home_team_score")
  awayTeamScore    Int?               @map("away_team_score")
  forfeit          Boolean            @default(false)
  overtime         Boolean            @default(false)
  status           String             @default("scheduled") @db.VarChar(20)
  playerMatchStats PlayerMatchStats[]
  matchEvents      MatchEvents[]
  // idx_matches_status_starts_at — partial index (WHERE status = 'scheduled') for the
  // scheduler's polling query. Prisma cannot express partial indexes, so it is
  // defined only in migration SQL — created in `0_init`, renamed with its column
  // in `20260815120000_rename_match_time_columns`.
  //
  // CHECK constraints on status, scores and teams live in migration SQL too:
  // `no_draws_allowed` in `0_init`, the rest in `20261103120000_match_integrity_checks`.

  @@index([poolId, startsAt], map: "idx_matches_pool_id_starts_at")
  @@index([homeTeamId], map: "idx_matches_home_team_id")
  @@index([awayTeamId], map: "idx_matches_away_team_id")
  @@index([startsAt], map: "idx_matches_starts_at")
  @@map("matches")
}

model Leaderboards {
  id              Int   @id @default(autoincrement())
  pool            Pools @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId          Int   @map("pool_id")
  team            Teams @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          Int   @map("team_id")
  points          Int   @default(0)
  gamesPlayed     Int   @default(0) @map("games_played")
  gamesWon        Int   @default(0) @map("games_won")
  gamesLost       Int   @default(0) @map("games_lost")
  gamesForfeited  Int   @default(0) @map("games_forfeited")
  pointsFor       Int   @default(0) @map("points_for")
  pointsAgainst   Int   @default(0) @map("points_against")
  pointDifference Int   @default(0) @map("point_difference")

  // Written only by the triggers on `matches` and `teams`. CHECK constraints on the counters
  // (non-negative, games and points add up) are in
  // `20261103120000_match_integrity_checks`.
  @@unique([poolId, teamId])
  @@map("leaderboards")
}

model Players {
  id                  Int                 @id @default(autoincrement())
  name                String              @db.VarChar(255)
  number              Int
  position            String              @db.VarChar(2)
  heightCm            Int                 @map("height_cm")
  weightKg            Int                 @map("weight_kg")
  birthdate           DateTime            @db.Date
  team                Teams               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId              Int                 @map("team_id")
  stats               PlayerMatchStats[]
  eventParticipations MatchEventPlayers[]

  @@unique([teamId, number])
  // Trigram index for the name search; pg_trgm is created by its migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_players_name_trgm")
  @@map("players")
}

model PlayerMatchStats {
  id                    Int     @id @default(autoincrement())
  match                 Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId               Int     @map("match_id")
  player                Players @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId              Int     @map("player_id")
  points                Int     @default(0) @map("points")
  fouls                 Int     @default(0) @map("fouls")
  threePointsMade       Int     @default(0) @map("three_points_made")
  threePointsAttempted  Int     @default(0) @map("three_points_attempted")
  twoPointsIntMade      Int     @default(0) @map("two_points_int_made")
  twoPointsIntAttempted Int     @default(0) @map("two_points_int_attempted")
  twoPointsExtMade      Int     @default(0) @map("two_points_ext_made")
  twoPointsExtAttempted Int     @default(0) @map("two_points_ext_attempted")
  freeThrowsMade        Int     @default(0) @map("free_throws_made")
  freeThrowsAttempted   Int     @default(0) @map("free_throws_attempted")
  assists               Int     @default(0) @map("assists")
  turnovers             Int     @default(0) @map("turnovers")
  reboundsOffensive     Int     @default(0) @map("rebounds_offensive")
  reboundsDefensive     Int     @default(0) @map("rebounds_defensive")
  steals                Int     @default(0) @map("steals")
  blocks                Int     @default(0) @map("blocks")
  playtimeIntervals     Json    @default("[]") @map("playtime_intervals")

  @@unique([matchId, playerId])
  @@index([playerId], map: "idx_player_match_stats_player_id")
  @@map("player_match_stats")
}

model MatchEvents {
  id             Int                 @id @default(autoincrement())
  match          Matches             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        Int                 @map("match_id")
  eventType      String              @map("event_type") @db.VarChar(50)
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz
  description    String?
  shotLocationId Int?                @map("shot_location_id")
  shotLocation   ShotLocations?      @relation(fields: [shotLocationId], references: [id], onDelete: SetNull)
  players        MatchEventPlayers[]

  @@index([matchId], map: "idx_match_events_match_id")
  @@map("match_events")
}

model ShotLocations {
  id     Int           @id @default(autoincrement())
  x      Decimal       @db.Decimal(5, 2)
  y      Decimal       @db.Decimal(5, 2)
  events MatchEvents[]

  @@map("shot_locations")
}

model MatchEventPlayers {
  id       Int         @id @default(autoincrement())
  event    MatchEvents @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  Int         @map("event_id")
  player   Players     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int         @map("player_id")
  role     String      @db.VarChar(50)

  @@index([eventId], map: "idx_match_event_players_event_id")
  @@index([playerId], map: "idx_match_event_players_player_id")
  @@map("match_event_players")
}

model SeedingCheckpoints {
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    Int      @map("entity_id")
  status      String   @default("completed") @db.VarChar(20)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz

  @@id([entityType, entityId])
  @@map("seeding_checkpoints")
}
