{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@modules/*": ["./modules/*"],
      "@common/*": ["./common/*"],
      "prisma/prisma.module": ["./prisma/prisma.module"],
      "prisma/prisma.service": ["./prisma/prisma.service"],
      "modules": ["./modules/index.ts"]
    },
    "outDir": "dist",
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "commonjs",
    "strict": true
  },
  "exclude": [],
  "include": ["**/*.ts", "**/*.tsx"]
}
