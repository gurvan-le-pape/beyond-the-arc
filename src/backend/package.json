{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch --ts-config tsconfig.build.json",
    "poststart:dev": "find dist -type f -name '*.spec.js' -exec rm -f {} + 2>/dev/null || true",
    "clean:specs": "find dist -name '*.spec.js' -type f -delete 2>/dev/null || true",
    "start": "nest start --ts-config tsconfig.json",
    "build": "prisma generate && nest build -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run clean:specs",
    "start:prod": "node dist/main",
    "test": "prisma generate && jest",
    "lint": "eslint '**/*.ts'",
    "lint:fix": "organize-imports-cli './*.ts' './common/**/*.ts' './modules/**/*.ts' './prisma/*.ts' './scripts/**/*.ts' && eslint '**/*.{ts,tsx}' --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:migrate-dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.9",
    "@nestjs/core": "^11.0.9",
    "@nestjs/platform-express": "^11.0.9",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.47.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "keyv": "^5.6.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.10.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.1.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "barrelsby": "^2.8.1",
    "eslint": "^9.20.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^30.4.2",
    "organize-imports-cli": "^1.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "3.7.4",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.0.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
