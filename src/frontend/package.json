{
  "name": "frontend",
  "version": "1.0.0",
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint '**/*.{ts,mts,tsx}'",
    "lint:fix": "organize-imports-cli './**/*.ts' './**/*.tsx' && eslint '**/*.{ts,mts,tsx}' --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "check:messages": "node scripts/check-message-parity.mts",
    "typegen": "node scripts/typegen.mts",
    "palette": "node scripts/generate-palette.mts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/nextjs": "^10.47.0",
    "@tanstack/react-query": "^5.90.20",
    "@turf/centroid": "^7.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^5.18.0",
    "next": "^15.5.21",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.18",
    "@radix-ui/colors": "3.0.0",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.1.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-compat": "^6.2.1",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "organize-imports-cli": "^1.0.2",
    "postcss": "^8.5.26",
    "prettier": "3.7.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
