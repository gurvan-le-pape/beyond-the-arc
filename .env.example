DATABASE_NAME=DB_NAME
DATABASE_USER=USER
DATABASE_PASSWORD=PASSWORD
DATABASE_HOST=database
# DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

FRONTEND_URL=https://beyondthearc.app
NEXT_PUBLIC_API_URL=https://beyondthearc.app/api
INTERNAL_API_URL=http://backend:4000/api

SENTRY_DSN=
# Build-time only: local `docker compose build` and the CI build upload source
# maps with it. Leave it out of the VPS .env — no running container uses it.
SENTRY_AUTH_TOKEN=

# VPS only. The registry path without a tag, and the deployed commit SHA; the
# deploy job rewrites IMAGE_TAG on every run, and a rollback sets it by hand.
# REGISTRY_IMAGE=ghcr.io/<owner>/beyond-the-arc
# IMAGE_TAG=

GRAFANA_ROOT_URL=
GRAFANA_PASSWORD=

SMTP_HOST=smtp.gmail.com:587
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop